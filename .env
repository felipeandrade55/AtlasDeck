# Admin credentials for Mission Control
ADMIN_PASSWORD=admin
AUTH_SECRET=dev-auth-secret-do-not-use-in-production

# OpenClaw paths (defaults shown - override if your setup differs)
# OPENCLAW_DIR=/root/.openclaw
# OPENCLAW_WORKSPACE=/root/.openclaw/workspace/mission-control
# IMPORTANT: if openclaw is not in the PATH of the Node.js process,
# set this to the absolute path, e.g. /usr/local/bin/openclaw
OPENCLAW_BIN=openclaw

# Cost monitoring
# COST_MONTHLY_BUDGET_USD=100
# COST_ALERT_THRESHOLD_PERCENT=80
# COST_AUTO_COLLECT_INTERVAL_MS=60000

# Weather default location (used as fallback when browser geolocation is unavailable/denied)
WEATHER_DEFAULT_LAT=-23.5505
WEATHER_DEFAULT_LON=-46.6333
WEATHER_DEFAULT_CITY=São Paulo

# Branding (customize for your instance)
NEXT_PUBLIC_AGENT_NAME=Mission Control
NEXT_PUBLIC_AGENT_EMOJI=🤖
NEXT_PUBLIC_AGENT_DESCRIPTION=Your AI co-pilot, powered by OpenClaw
NEXT_PUBLIC_AGENT_LOCATION=
NEXT_PUBLIC_BIRTH_DATE=
NEXT_PUBLIC_AGENT_AVATAR=
NEXT_PUBLIC_OWNER_NAME=Felipe
NEXT_PUBLIC_OWNER_USERNAME=felipeandrade55
NEXT_PUBLIC_OWNER_EMAIL=felipeandrade55@gmail.com
NEXT_PUBLIC_OWNER_COLLAB_EMAIL=collabs@example.com
NEXT_PUBLIC_TWITTER_HANDLE=@username
NEXT_PUBLIC_COMPANY_NAME=MISSION CONTROL, INC.
NEXT_PUBLIC_APP_TITLE=Mission Control

