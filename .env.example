# Admin credentials for Mission Control
ADMIN_PASSWORD=change-me-to-a-strong-password
AUTH_SECRET=generate-a-random-32-char-string-here

# Auto-update (optional - increases GitHub API rate limit from 60 to 5000/hour)
# GITHUB_TOKEN=ghp_your_personal_access_token

# OpenClaw paths (defaults shown - override if your setup differs)
# IMPORTANT: if 'openclaw' is not in the PATH of the Node.js process,
# set OPENCLAW_BIN to the absolute path, e.g. /usr/local/bin/openclaw
# OPENCLAW_DIR=/root/.openclaw
# OPENCLAW_WORKSPACE=/root/.openclaw/workspace/mission-control
# OPENCLAW_BIN=openclaw

# Cost monitoring
# COST_MONTHLY_BUDGET_USD=100
# COST_ALERT_THRESHOLD_PERCENT=80
# COST_AUTO_COLLECT_INTERVAL_MS=60000

# Weather widget default location (used when browser geolocation is denied/unavailable)
# WEATHER_DEFAULT_LAT=-23.5505
# WEATHER_DEFAULT_LON=-46.6333
# WEATHER_DEFAULT_CITY=São Paulo

# Memory subsystem (semantic memory + auto-extraction + AUTO_RECALL injection)
# All defaults work out-of-the-box. Override only to debug or tune.
# MEMORY_SCHEDULER_DISABLED=1                         # disable background extraction/injection entirely
# MEMORY_EXTRACTION_INTERVAL_MS=900000                # default 15 min
# MEMORY_INJECTION_INTERVAL_MS=1800000                # default 30 min
# MEMORY_HOUSEKEEP_INTERVAL_MS=3600000                # default 1 hour
# MEMORY_EXTRACTION_CMD=                              # override OpenClaw CLI args used by the extractor (advanced)
# MEMORY_DEBUG=1                                      # verbose logs from the memory subsystem
# OLLAMA_BASE_URL=http://127.0.0.1:11434              # local Ollama daemon when extractor_provider=ollama

# Branding (customize for your instance)
NEXT_PUBLIC_AGENT_NAME=Mission Control
NEXT_PUBLIC_AGENT_EMOJI=🤖
NEXT_PUBLIC_AGENT_DESCRIPTION=Your AI co-pilot, powered by OpenClaw
NEXT_PUBLIC_AGENT_LOCATION=
NEXT_PUBLIC_BIRTH_DATE=
NEXT_PUBLIC_AGENT_AVATAR=
NEXT_PUBLIC_OWNER_NAME=Your Name
NEXT_PUBLIC_OWNER_USERNAME=your-username
NEXT_PUBLIC_OWNER_EMAIL=your-email@example.com
NEXT_PUBLIC_OWNER_COLLAB_EMAIL=collabs@example.com
NEXT_PUBLIC_TWITTER_HANDLE=@username
NEXT_PUBLIC_COMPANY_NAME=MISSION CONTROL, INC.
NEXT_PUBLIC_APP_TITLE=Mission Control
