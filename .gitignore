# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (contains sensitive credentials)
.env*
!.env.example

# production data (contains instance-specific operational data)
/data/*.json
!data/*.example.json
/data/*.db
/data/*.db-shm
/data/*.db-wal
/data/*.sqlite
/data/*.sqlite3
/data/incidents/
/data/dev-workspaces/
# segredo app↔toolbox de pentest — NUNCA versionar nem deixar `git stash -u` levar
/data/.pentest-toolbox.token

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# design files (local only)
/design/

# backup files
*.bak

# openWakeWord runtime — copied by `npm run postinstall`, never committed
public/openwakeword/ort-wasm-simd-threaded.wasm
public/openwakeword/ort-wasm-simd-threaded.mjs
public/openwakeword/ort-wasm-simd-threaded.jsep.wasm
public/openwakeword/ort-wasm-simd-threaded.jsep.mjs
